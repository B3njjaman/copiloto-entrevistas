# Copy this file to copiloto.env and uncomment what you want to change.
# Real environment variables take precedence over this file. The app trusts it
# like its own code (e.g. CLUELY_CLAUDE_CMD is a program it runs), so keep it local.

# Your first name, so "Ana, ¿qué opinas?" counts as a question for you.
# CLUELY_MY_NAME=Ana

# Language of the call: es, en, ... or auto.
# CLUELY_WHISPER_LANGUAGE=es

# Transcription model: small (fast), medium, large-v3-turbo (more accurate, needs a GPU).
# CLUELY_WHISPER_MODEL=small
# CLUELY_WHISPER_DEVICE=cuda

# Where to download whisper models (default: Hugging Face cache in your user folder).
# CLUELY_WHISPER_DIR=D:\models\whisper

# Claude model for live answers (fast) and for typed / screen questions.
# CLUELY_AUTO_MODEL=haiku
# CLUELY_CLAUDE_MODEL=sonnet

# Voice calibration: tell your voice from others' on the mic (0 = off), and how
# close a phrase must be to your voiceprint to count as you (lower = more "Tú").
# CLUELY_VOICE_ID=1
# CLUELY_VOICE_THRESHOLD=0.5

# Use the mascot and colours in skin/ (made by scripts/make_skin.py); 0 = default theme.
# CLUELY_SKIN=1

# Silence that ends a phrase (lower = faster answers, more phrases cut in half)
# and the longest phrase if the speaker never pauses.
# CLUELY_PAUSE_SECONDS=0.5
# CLUELY_CHUNK_SECONDS=6.0
